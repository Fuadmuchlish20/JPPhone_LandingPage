# ===== Caddy
HOST_DOMAIN=host1.claudeemulator.net
ACME_EMAIL=admin@claudeemulator.net
# Space-separated CIDRs allowed to call /api/* (HMAC still required). Default: any.
AGENT_API_ALLOWED_IPS=0.0.0.0/0 ::/0

# ===== device-agent (see apps/device-agent/.env.example for all options)
HOST_ID=00000000-0000-0000-0000-000000000000
AGENT_HMAC_SECRET=change-me
STREAM_JWT_SECRET=change-me
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
WEB_ORIGIN=https://claudeemulator.net

# On ARM64 hosts redroid publishes multi-arch tags; same tag works.
# Android version -> Redroid image (comma-separated "version=image"). Only these versions can be created on this host;
# every host should offer every version listed in plans.android_versions. Verify tags exist for your CPU arch.
REDROID_IMAGES=10=redroid/redroid:10.0.0-latest,12=redroid/redroid:12.0.0-latest,13=redroid/redroid:13.0.0-latest,15=redroid/redroid:15.0.0_64only-latest
REDROID_NETWORK=redroid-net
REDROID_GPU_MODE=guest
DEVICE_WIDTH=720
DEVICE_HEIGHT=1280
DEVICE_DPI=320
DEVICE_FPS=30

STORAGE_MODE=loop
DEVICES_DIR=/data/devices
SCRCPY_VERSION=3.3.1
HEARTBEAT_INTERVAL_MS=30000
APK_MAX_MB=500
LOG_LEVEL=info
