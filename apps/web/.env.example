# Public
NEXT_PUBLIC_SITE_URL=https://jpphone.com
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only
SUPABASE_SERVICE_ROLE_KEY=
# Must match every device-agent
AGENT_HMAC_SECRET=change-me-64-random-hex
STREAM_JWT_SECRET=change-me-64-random-hex
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=change-me

# Account → Support (each is optional; unset channels are hidden)
SUPPORT_CHAT_URL=
SUPPORT_EMAIL=
BUSINESS_EMAIL=
DISCORD_URL=

# Separate user dashboard app (no trailing slash)
NEXT_PUBLIC_DASHBOARD_URL=https://dashboard.jpphone.com
