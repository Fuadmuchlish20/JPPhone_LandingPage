# ---- identity (hosts.id row in Supabase)
HOST_ID=00000000-0000-0000-0000-000000000000

# ---- secrets (must match apps/web)
AGENT_HMAC_SECRET=change-me-64-random-hex
STREAM_JWT_SECRET=change-me-64-random-hex

# ---- Supabase (service role: heartbeat + device status updates)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---- HTTP (Caddy terminates TLS and proxies to this)
AGENT_LISTEN_HOST=127.0.0.1
AGENT_LISTEN_PORT=8080
# Browser origin allowed to upload APKs directly to this host
WEB_ORIGIN=https://claudeemulator.net

# ---- Docker / Redroid
# Android version -> Redroid image (comma-separated "version=image"). Only these versions can be created on this host;
# every host should offer every version listed in plans.android_versions. Verify tags exist for your CPU arch.
REDROID_IMAGES=10=redroid/redroid:10.0.0-latest,12=redroid/redroid:12.0.0-latest,13=redroid/redroid:13.0.0-latest,15=redroid/redroid:15.0.0_64only-latest
REDROID_NETWORK=redroid-net
# guest = software rendering (SwiftShader), host = pass /dev/dri to the container
REDROID_GPU_MODE=guest
DEVICE_WIDTH=720
DEVICE_HEIGHT=1280
DEVICE_DPI=320
DEVICE_FPS=30

# ---- Storage: loop = per-device ext4 image with hard size limit, dir = plain folder (dev only)
STORAGE_MODE=loop
DEVICES_DIR=/data/devices

# ---- scrcpy (server jar version MUST match SCRCPY_VERSION exactly)
SCRCPY_VERSION=3.3.1
SCRCPY_SERVER_PATH=/opt/scrcpy/scrcpy-server.jar

# ---- misc
HEARTBEAT_INTERVAL_MS=30000
APK_MAX_MB=500
LOG_LEVEL=info
